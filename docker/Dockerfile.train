FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-train.txt .
RUN pip install --no-cache-dir -r requirements-train.txt

COPY src/ src/
COPY params.yaml .
COPY data/raw/jailbreak.csv data/raw/jailbreak.csv
COPY data/raw/jailbreak.csv.dvc data/raw/jailbreak.csv.dvc

ARG GIT_COMMIT=unknown
ENV GIT_COMMIT=${GIT_COMMIT}

RUN useradd --create-home --uid 1000 trainer && chown -R trainer /app
USER 1000

CMD ["sh", "-c", "python src/prepare.py && python src/train.py && python src/evaluate.py"]